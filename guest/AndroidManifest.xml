<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.dan.androidsubsystem">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application android:label="Mac Bridge" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".BridgeIme" android:label="Mac Bridge Keyboard" android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/ime" />
        </service>
        <activity android:name=".BridgeActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".BridgeProvider" android:authorities="dev.dan.androidsubsystem.bridge" android:exported="true" android:readPermission="android.permission.DUMP" />
        <service android:name=".BridgeNotifications" android:label="Mac Notification Bridge" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
    </application>
</manifest>
