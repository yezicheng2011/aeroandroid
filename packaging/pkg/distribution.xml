<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>aeroandroid @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="app"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="app" visible="false" title="Android Subsystem">
        <pkg-ref id="dev.dan.androidsubsystem"/>
    </choice>
    <pkg-ref id="dev.dan.androidsubsystem" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
