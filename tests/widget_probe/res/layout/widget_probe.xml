<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#FFF4F6FA">
  <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Widget Probe" android:textColor="#FF17233B" android:textSize="18sp" android:textStyle="bold" />
  <TextView android:id="@+id/counter" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Count: 0" android:textColor="#FF17233B" android:textSize="20sp" />
  <TextView android:id="@+id/dimensions" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Waiting for widget options" android:textColor="#FF394B69" android:textSize="12sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <Button android:id="@+id/increment" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Increment" />
    <Button android:id="@+id/open_app" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="Open App" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Scroll the list; tap an item to open its details." android:textColor="#FF394B69" android:textSize="12sp" />
  <ListView android:id="@+id/items" android:layout_width="match_parent" android:layout_height="0dp"
      android:layout_weight="1" android:divider="#FFCED5E1" android:dividerHeight="1dp" />
</LinearLayout>
